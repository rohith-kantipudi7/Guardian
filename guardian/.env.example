# Copy to .env (git-ignored). Never commit real secrets.

# Backend / dashboard / simulator
# 127.0.0.1 avoids a slow IPv6 "localhost" fallback on Windows.
BACKEND_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./guardian.db
WS_URL=ws://localhost:8000/ws/emergency
# leaflet (OpenStreetMap, needs internet) | none (offline coordinates view)
MAP_PROVIDER=leaflet
DEMO_MODE=true
REQUIRE_DEVICE_AUTH=true
DEVICE_OFFLINE_AFTER_SECONDS=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Device identity (simulator). Firmware uses include/config/secrets.h.
DEVICE_ID=GD-001
VEHICLE_ID=VH-001
DEVICE_SECRET=dev-secret-change-me

