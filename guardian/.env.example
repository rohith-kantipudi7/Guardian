# Copy to .env (git-ignored). Never commit real secrets.

# Backend / dashboard / simulator
# 127.0.0.1 avoids a slow IPv6 "localhost" fallback on Windows.
BACKEND_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./guardian.db
WS_URL=ws://localhost:8000/ws/emergency
# leaflet (OpenStreetMap, needs internet) | none (offline coordinates view)
MAP_PROVIDER=leaflet
DEMO_MODE=true
REQUIRE_DEVICE_AUTH=true
DEVICE_OFFLINE_AFTER_SECONDS=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Device identity (simulator). Firmware uses include/config/secrets.h.
DEVICE_ID=GD-001
VEHICLE_ID=VH-001
DEVICE_SECRET=dev-secret-change-me

# Cloud AI (OPTIONAL fallback only — on-device AI is primary). Put your rotated keys in .env (git-ignored).
# Rotate any key that was ever shared in chat before using it.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

AZURE_CLAUDE_ENDPOINT=https://<your-resource>.services.ai.azure.com/anthropic/v1/
AZURE_CLAUDE_API_KEY=your-azure-claude-key
AZURE_CLAUDE_DEPLOYMENT=claude-fable-5

AZURE_EMBEDDING_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_EMBEDDING_API_KEY=your-azure-embedding-key
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small


# Azure OpenAI text-to-speech (spoken emergency call message)
AZURE_TTS_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_TTS_DEPLOYMENT=gpt-4o-mini-tts
AZURE_TTS_API_VERSION=2025-03-01-preview
AZURE_TTS_API_KEY=your-azure-tts-key

